        "samples_limit": 4000,
        "train_ratio": 0.75,
        "seed": 42,
        "model_id": 1,
        "epochs": 1000,
        "train_noise": 0.01
      }
    }
  ],

  "FEATURE_LIST": [
    {
      "name": "feature_set_1",
      "features": [
        {
          "feature": "sma",
          "params": { 
            "start": 10, 
            "stop": 50, 
            "step": 5, 
            "source_column": "close" 
          }
        }
      ]
    }
  ],

  "TARGET_LIST": [
