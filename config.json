{
  "INSTRUMENT_TYPES": ["index", "future", "crypto", "currency_pair"],
 
  "BROKER_COLUMNS": ["date", "time", "open", "high", "low", "close", "volume"],

  "FINAL_COLUMNS": ["datetime", "close", "open", "high", "low", "volume"],

  "INTERVAL_SETTINGS": {
    "1d":  {"range": "max",  "check_period": "M", "min_count": 18},
    "1wk": {"range": "max",  "check_period": "Y", "min_count": 45},
    "1mo": {"range": "max",  "check_period": "Y", "min_count": 10},
    "1h":  {"range": "730d", "check_period": "W", "min_count": 100},
    "15m": {"range": "60d",  "check_period": "D", "min_count": 50},
    "5m":  {"range": "60d",  "check_period": "D", "min_count": 200},
    "2m":  {"range": "60d",  "check_period": "H", "min_count": 25},
    "1m":  {"range": "7d",   "check_period": "H", "min_count": 50}
  },

  "CUSTOM_NAMES": {
    "US100": {"index": "^NDX", "future": "NQ=F"},
    "DE40":  {"index": "^GDAXI", "future": "FDAX.EX"},
    "BTC":   {"crypto": "BTC-USD"},
    "GOLD":  {"future": "GC=F", "index": "GC=F"},
    "BRENT": {"future": "BZ=F"},
    "CABLE": {"currency_pair": "GBPUSD=X"}
  },

  "SUPPORTED_FEATURES": {
    "sma": {
      "supported_params": ["start", "end", "step", "source_column"]
    }
  },
  
  "INSTRUMENT_LIST": [
    {
      "name": "instrument_1",
      "params": {
        "name": "EURUSD",
